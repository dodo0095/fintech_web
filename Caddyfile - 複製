starklab.tw {
    encode zstd gzip

    # 🚫 阻擋惡意掃描
    @blocked {
        path_regexp /\.(git|svn|hg|env)|(\.php)$
    }
    respond @blocked 403

    # ✅ robots.txt
handle_path /robots.txt {
    respond "User-agent: *\nDisallow:" 200
    header Content-Type "text/plain"
}

    # 先處理靜態檔
    handle_path /static/* {
        root * "C:\server website\fintech_web\stark_lab\staticfiles"
        file_server
    }

    handle_path /media/* {
        root * "C:\server website\fintech_web\stark_lab\media"
        file_server
    }

    # 熱修：若前端用 /images/ 開頭
    handle_path /images/* {
        root * "C:\server website\fintech_web\staticfiles\stark_lab\images"
        file_server
    }

    # 其餘請求才交給後端
    handle {
        reverse_proxy 127.0.0.1:8000
    }

    # HTTP -> HTTPS（可留可拿掉；Caddy 會自動開 HTTPS）
    @http {
        protocol http
    }
    redir @http https://{host}{uri}

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:"
        Cross-Origin-Opener-Policy "same-origin"
    }
}


