# stark_lab 環境變數範例（複製為 .env 後填值；.env 已被 gitignore 不進版控）

# === notify 盤勢通報 ===
DISCORD_ENABLED=true          # 是否啟用 Discord 推播
DISCORD_WEBHOOK_URL=          # Discord 頻道 Webhook 網址（機密，勿硬編碼）
DRY_RUN=false                 # true=只寫 log 不實送，驗證用
SCHEDULER_ENABLED=true        # run_scheduler 是否啟動排程
DATA_LOOKBACK_DAYS=90         # 抓取回溯天數（日曆天）
SCHEDULE_TW=08:00             # 台股通報時間（台灣時間，逗號可多時段）
SCHEDULE_US=20:00             # 美股通報時間（台灣時間，逗號可多時段）

# --- 盤整過濾（選填，預設就啟用；詳見 notify/README.md 實務調參指南）---
RANGING_FILTER_ENABLED=true   # 盤整時壓制交叉類假訊號的總開關；false=關閉、回到原始行為
ADX_RANGING_THRESHOLD=25      # 盤整判定門檻：越高過濾越多(訊號少)、越低過濾越少(訊號多)
