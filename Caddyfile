# =========================
# 五金行庫存系統 hardware.starklab.tw
# =========================
hardware.starklab.tw {
    encode gzip

    # 👉 1) 短路掃描
    @phpProbes path_regexp php (.*\.php.*)|(.*\/wp\/.*)|(^\/wp$)|(.*\/wp-admin\/.*)|(.*\/wp-includes\/.*)
    handle @phpProbes {
        respond 403
    }
    @configProbes path_regexp cfg (?i)(.*\/?config.*\.json$)|(.*appsettings.*\.json$)|(.*angular\.json$)|(.*tsconfig\.json$)|(.*\.env$)|(.*\/\.?aws\/.*)|(.*\.yml$)
    handle @configProbes {
        respond 403
    }
    @phpinfoProbes path_regexp phpinfo (?i)(.*phpinfo.*)|(^\/_profiler\/phpinfo$)|(^\/symfony\/_profiler\/phpinfo$)
    handle @phpinfoProbes {
        respond 403
    }

    # 允許 ACME 憑證驗證
    @dotProbes {
        not path /.well-known/*
        path_regexp dotfiles ^/\..*
    }
    handle @dotProbes {
        respond 403
    }

 @dirScan {
        not path /products/*
        not path /suppliers/*
        not path /purchases/*
        not path /categories/*
        path_regexp dirs (?i)\/(backup|old|new|site|site1|main|web|portal|cms|blog2?|store|shop|wordpress|wp|en|de|fr|us|v2|202[3-5])(\/|$)
    }
    handle @dirScan {
        respond 404
    }



    # 👉 2) favicon 直接 204
    respond /favicon.ico 204
    respond /apple-touch-icon.png 204
    respond /apple-touch-icon-precomposed.png 204
    respond /static/favicon.png 204

    # 👉 3) 限制請求本文大小（圖片上傳調大為 10MB）
    request_body {
        max_size 10MB
    }

    @blocked {
        path_regexp blocked /\.(git|svn|hg|env)|(\.php)$
    }
    respond @blocked 403

    # ✅ robots.txt
    handle_path /robots.txt {
        respond "User-agent: *\nDisallow: /" 200
        header Content-Type "text/plain"
    }

    # ✅ 靜態檔
    handle_path /static/* {
        root * "C:\server website\hardware_store\staticfiles"
        file_server
    }

    # ✅ 媒體檔（商品圖片）
    handle_path /media/* {
        root * "C:\server website\hardware_store\media"
        file_server
    }

    # 其他交給後端
    handle {
        reverse_proxy 127.0.0.1:2000
    }

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:"
        Cross-Origin-Opener-Policy "same-origin"
    }
}

